# إعدادات ZK system على السيرفر. انسخ هذا الملف باسم .env وعبّيه. لا ترفع .env على GitHub أبدًا.

# الدومين اللي تفتح عليه المنظومة (لازم يأشر على عنوان السيرفر) - مثال: zk.example.com
DOMAIN=zk.example.com

# كلمة مرور المدير admin عند أول تشغيل فقط (قاعدة فاضية). 6 حروف/أرقام على الأقل، وغيّرها بعدها من المنظومة.
ERP_ADMIN_PASSWORD=

# مفتاح الجلسات (اختياري): إن تُرك فاضي يُولَّد مفتاح عشوائي ويُحفظ في مجلد البيانات تلقائيًا
ERP_SECRET_KEY=

# ليبيا = 2. مهم على السيرفر لأن ساعته غالبًا بتوقيت غرينتش
ERP_TZ_OFFSET_HOURS=2

# كل كم دقيقة تُؤخذ نسخة احتياطية في مجلد البيانات (الافتراضي 60)
BACKUP_INTERVAL_MINUTES=60

# مدة بقاء تسجيل الدخول بالساعات قبل ما يطلب الدخول من جديد
ERP_SESSION_HOURS=12

# 1 إذا السيرفر يعمل بـ HTTPS (كوكيز آمنة + HSTS). docker-compose يضبطه تلقائيًا
# ERP_HTTPS=1
# 1 إذا البرنامج خلف بروكسي (Caddy/Nginx/منصة استضافة). docker-compose يضبطه تلقائيًا
# ERP_BEHIND_PROXY=1
